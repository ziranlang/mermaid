#scope_module
// Bounded sequence timelines and explicitly nested control fragments.


Person :: struct { id: Label; name: Label; declared: bool }
EventKind :: enum { MESSAGE; OPEN; BRANCH; CLOSE; NOTE }
Event :: struct {
    from_id: Label
    to_id: Label
    kind: EventKind
    from: s32
    to: s32
    text: Label
    dashed: bool
    arrow: u32
    left: s32
    right: s32
}
Block :: struct { kind: Label; branched: bool }

RenderSequence :: (source: string, statements: []Statement, count: s32, max_width: s64, canvas: *Canvas) -> Error {
    people: [8]Person; people_count: s32 = 0
    events: Vec(Event); event_count: s32 = 0
    blocks: [4]Block; block_count: s32 = 0
    statement_at: s32 = 0
    while statement_at < count {
        line := statements[statement_at].text
        statement_at += 1
        event: Event
        if StartsWith(line, "participant ") || StartsWith(line, "actor ") {
            actor := StartsWith(line, "actor ")
            rest := line[ifx actor then 6 else 12:line.count]
            id := ParseIdentifier(rest); rest = id.rest

            if id.at < 0 { return ErrorFromInt(id.at) }
            label: Label; trimmed := TrimStart(rest)
            if StartsWith(trimmed, "as ") {
                status := CheckLabel(trimmed[3:trimmed.count])
                if status != .NONE { return status }
                if !LabelSet(*label, trimmed[3:trimmed.count]) { return .UNSUPPORTED }
            } else if Trim(rest).count == 0 { LabelSet(*label, id.value) }
            else { return .UNSUPPORTED }
            index := Participant(people[:], *people_count, id.value)
            if index < 0 { return ErrorFromInt(index) }
            if people[index].declared { return .UNSUPPORTED }
            if actor {
                LabelAppendPrefix(*people[index].name, "", *label)
                LabelAppendSelf(*people[index].name, " (actor)")
            } else { LabelSetLabel(*people[index].name, *label) }
            people[index].declared = true
            continue
        }
        if (line == "end") {
            if block_count == 0 { return .UNSUPPORTED }
            block_count -= 1; event.kind = .CLOSE
        } else if StartsWith(line, "else ") {
            if block_count == 0 || !LabelEqualText(*blocks[block_count - 1].kind, "alt") || blocks[block_count - 1].branched { return .UNSUPPORTED }
            blocks[block_count - 1].branched = true
            status := CheckLabel(line[5:line.count])
            if status != .NONE { return status }
            if !LabelSet(*event.text, "else ") || !LabelAppend(*event.text, "else ", line[5:line.count]) { return .UNSUPPORTED }
            event.kind = .BRANCH
        } else if StartsWith(line, "loop ") || StartsWith(line, "alt ") || StartsWith(line, "opt ") || StartsWith(line, "critical ") || StartsWith(line, "break ") {
            kind := SplitWhitespaceFirst(line)
            text := line[kind.count + 1:line.count]
            status := CheckLabel(text)
            if status != .NONE { return status }
            if block_count == 4 { return .LIMIT }
            LabelSet(*blocks[block_count].kind, kind)
            blocks[block_count].branched = false; block_count += 1
            LabelSet(*event.text, line); event.kind = .OPEN
        } else if StartsWith(line, "Note over ") || StartsWith(line, "note over ") {
            rest := line[10:line.count]
            left_id := ParseIdentifier(rest); rest = left_id.rest

            if left_id.at < 0 { return ErrorFromInt(left_id.at) }
            left := Participant(people[:], *people_count, left_id.value)
            if left < 0 { return ErrorFromInt(left) }
            right := left; trimmed := TrimStart(rest)
            if StartsWith(trimmed, ",") {
                rest = trimmed[1:trimmed.count]
                right_id := ParseIdentifier(rest); rest = right_id.rest

                if right_id.at < 0 { return ErrorFromInt(right_id.at) }
                right = Participant(people[:], *people_count, right_id.value)
                if right < 0 { return ErrorFromInt(right) }
            }
            text := TrimStart(rest)
            if !StartsWith(text, ":") { return .UNSUPPORTED }
            value := Trim(text[1:text.count]); status := CheckLabel(value)
            if status != .NONE { return status }
            LabelSet(*event.text, value); event.kind = .NOTE
            event.left = ifx left < right then left else right; event.right = ifx left > right then left else right
        } else {
            status := MessageEvent(line, *event)
            if status != .NONE { return status }
            event.from = ParticipantLabel(people[:], *people_count, *event.from_id)
            if event.from < 0 { return ErrorFromInt(event.from) }
            event.to = ParticipantLabel(people[:], *people_count, *event.to_id)
            if event.to < 0 { return ErrorFromInt(event.to) }
        }
        if event_count == 64 { return .LIMIT }
        VecPush(events, event); event_count += 1
    }
    if block_count != 0 || people_count == 0 { return .UNSUPPORTED }
    return DrawSequence(people[:], people_count, events[:], event_count, max_width, canvas)
}

MessageEvent :: (line: string, event: *Event) -> Error {
    rest := line; id := ParseIdentifier(rest); rest = id.rest

    if id.at < 0 { return ErrorFromInt(id.at) }
    LabelSet(*event.from_id, id.value)
    rest = TrimStart(rest)
    token := -1; arrow := cast(u32)0; dashed := false
    if StartsWith(rest, "-->>") { token = 0; arrow = cast(u32)0x25b6; dashed = true }
    else if StartsWith(rest, "->>") { token = 1; arrow = cast(u32)0x25b6; dashed = false }
    else if StartsWith(rest, "-->") { token = 2; arrow = cast(u32)0x2504; dashed = true }
    else if StartsWith(rest, "->") { token = 3; arrow = cast(u32)0x2500; dashed = false }
    else if StartsWith(rest, "--x") { token = 4; arrow = cast(u32)#char "x"; dashed = true }
    else if StartsWith(rest, "-x") { token = 5; arrow = cast(u32)#char "x"; dashed = false }
    if token < 0 { return .UNSUPPORTED }
    if token == 0 { rest = rest[4:rest.count] }
    else if token == 1 { rest = rest[3:rest.count] }
    else if token == 2 { rest = rest[3:rest.count] }
    else if token == 3 { rest = rest[2:rest.count] }
    else if token == 4 { rest = rest[3:rest.count] }
    else { rest = rest[2:rest.count] }
    event.dashed = dashed; event.arrow = arrow
    to := ParseIdentifier(rest); rest = to.rest

    if to.at < 0 { return ErrorFromInt(to.at) }
    LabelSet(*event.to_id, to.value)
    text := TrimStart(rest)
    if !StartsWith(text, ":") { return .UNSUPPORTED }
    value := Trim(text[1:text.count]); status := CheckLabel(value)
    if status != .NONE { return status }
    LabelSet(*event.text, value); event.kind = .MESSAGE
    return .NONE
}

Participant :: (people: []Person, count: *s32, id: string) -> s32 {
    index: s32 = 0
    while index < count.* {
        if LabelEqualText(*people[index].id, id) { return index }
        index += 1
    }
    if count.* == 8 { return ErrorInt(.LIMIT) }
    LabelSet(*people[count.*].id, id); LabelSet(*people[count.*].name, id)
    people[count.*].declared = false; count.* += 1
    return count.* - 1
}

ParticipantLabel :: (people: []Person, count: *s32, id: *Label) -> s32 {
    index: s32 = 0
    while index < count.* {
        if LabelEqual(*people[index].id, id) { return index }
        index += 1
    }
    if count.* == 8 { return ErrorInt(.LIMIT) }
    LabelSetLabel(*people[count.*].id, id); LabelSetLabel(*people[count.*].name, id)
    people[count.*].declared = false; count.* += 1
    return count.* - 1
}

DrawSequence :: (people: []Person, people_count: s32, events: []Event, event_count: s32, max_width: s64, canvas: *Canvas) -> Error {
    name_width: s32 = 0; text_width: s32 = 0; index: s32 = 0
    while index < people_count {
        width := LabelWidth(*people[index].name)
        if width > name_width { name_width = width }
        index += 1
    }
    index = 0
    while index < event_count {
        width := LabelWidth(*events[index].text)
        if events[index].kind == .NOTE { width += 6 }
        if events[index].kind != .CLOSE && width > text_width { text_width = width }
        index += 1
    }
    box_width := name_width + 4; stride := box_width + 2
    if text_width + 4 > stride { stride = text_width + 4 }
    centers: [8]s32; index = 0
    while index < people_count { centers[index] = 10 + box_width / 2 + stride * index; index += 1 }
    last := centers[people_count - 1]
    width := last + box_width - box_width / 2 + 10
    if last + text_width + 14 > width { width = last + text_width + 14 }
    height: s32 = 3; index = 0
    while index < event_count {
        if events[index].kind == .MESSAGE && events[index].from == events[index].to { height += 4 } else { height += 3 }
        index += 1
    }
    if cast(s64)width * cast(s64)height > MAX_CELLS { return .LIMIT }
    canvas.width = width; canvas.height = height; canvas.horizontal = false
    CanvasFill(canvas, cast(u32)#char " ", cast(u8)Role.EDGE)
    index = 0
    while index < people_count {
        left := centers[index] - box_width / 2; right := left + box_width - 1
        CanvasSet(canvas, left, 0, cast(u32)0x250c, Role.NODE); CanvasSet(canvas, right, 0, cast(u32)0x2510, Role.NODE)
        CanvasSet(canvas, left, 2, cast(u32)0x2514, Role.NODE); CanvasSet(canvas, right, 2, cast(u32)0x2518, Role.NODE)
        x := left + 1
        while x < right {
            CanvasSet(canvas, x, 0, cast(u32)0x2500, Role.NODE); CanvasSet(canvas, x, 2, cast(u32)0x2500, Role.NODE); x += 1
        }
        CanvasSet(canvas, left, 1, cast(u32)0x2502, Role.NODE); CanvasSet(canvas, right, 1, cast(u32)0x2502, Role.NODE)
        PutText(canvas, left + 2, 1, *people[index].name); index += 1
    }
    depth: s32 = 0; row := 3; index = 0
    while index < event_count {
        event := *events[index]; count := 3
        if event.kind == .MESSAGE && event.from == event.to { count = 4 }
        top := row; row += count; center := 0
        while center < people_count {
            level := 0
            while level < count { CanvasSet(canvas, centers[center], top + level, cast(u32)0x2502, Role.EDGE); level += 1 }
            center += 1
        }
        level := 0
        while level < depth {
            line := top
            while line < top + count {
                CanvasSet(canvas, level * 2, line, cast(u32)0x2502, Role.NODE)
                CanvasSet(canvas, width - 1 - level * 2, line, cast(u32)0x2502, Role.NODE)
                line += 1
            }
            level += 1
        }
        if event.kind == .MESSAGE {
            a := centers[event.from]; b := centers[event.to]; arrow := event.arrow
            if a >= b && arrow == cast(u32)0x25b6 { arrow = cast(u32)0x25c0 }
            stroke := ifx event.dashed then cast(u32)0x2504 else cast(u32)0x2500
            PutText(canvas, ifx a < b then a + 2 else b + 2, top, *event.text)
            if a == b {
                x := a
                while x < a + 4 { CanvasSet(canvas, x, top + 1, stroke, Role.EDGE); CanvasSet(canvas, x, top + 2, stroke, Role.EDGE); x += 1 }
                CanvasSet(canvas, a, top + 1, cast(u32)0x251c, Role.EDGE); CanvasSet(canvas, a + 4, top + 1, cast(u32)0x2510, Role.EDGE)
                CanvasSet(canvas, a + 4, top + 2, cast(u32)0x2518, Role.EDGE); CanvasSet(canvas, a, top + 2, arrow, Role.EDGE)
            } else {
                low := ifx a < b then a else b; high := ifx a > b then a else b; x := low
                while x <= high { CanvasSet(canvas, x, top + 1, stroke, Role.EDGE); x += 1 }
                center = 0
                while center < people_count {
                    if centers[center] > low && centers[center] < high { CanvasSet(canvas, centers[center], top + 1, cast(u32)0x253c, Role.EDGE) }
                    center += 1
                }
                CanvasSet(canvas, a, top + 1, ifx a < b then cast(u32)0x251c else cast(u32)0x2524, Role.EDGE)
                CanvasSet(canvas, b, top + 1, arrow, Role.EDGE)
            }
        } else if event.kind == .NOTE {
            label: Label
            if !LabelSet(*label, "Note: ") { return .UNSUPPORTED }
            if !LabelAppendLabel(*label, *label, LabelView(event.text.bytes[:], event.text.overflow[:], event.text.length)) { return .UNSUPPORTED }
            start := centers[event.left]; end := centers[event.right]
            minimum := start + LabelWidth(*label) + 3
            if end < minimum { end = minimum }
            x := start
            while x <= end {
                CanvasSet(canvas, x, top, cast(u32)0x2500, Role.NODE); CanvasSet(canvas, x, top + 2, cast(u32)0x2500, Role.NODE)
                CanvasSet(canvas, x, top + 1, cast(u32)#char " ", Role.NODE); x += 1
            }
            CanvasSet(canvas, start, top, cast(u32)0x250c, Role.NODE); CanvasSet(canvas, end, top, cast(u32)0x2510, Role.NODE)
            CanvasSet(canvas, start, top + 2, cast(u32)0x2514, Role.NODE); CanvasSet(canvas, end, top + 2, cast(u32)0x2518, Role.NODE)
            CanvasSet(canvas, start, top + 1, cast(u32)0x2502, Role.NODE); CanvasSet(canvas, end, top + 1, cast(u32)0x2502, Role.NODE)
            PutText(canvas, start + 2, top + 1, *label)
        } else if event.kind == .OPEN || event.kind == .BRANCH {
            opening := event.kind == .OPEN
            if opening { depth += 1 }
            left := (depth - 1) * 2; right := width - 1 - left; x := left
            while x <= right { CanvasSet(canvas, x, top, cast(u32)0x2500, Role.NODE); x += 1 }
            CanvasSet(canvas, left, top, ifx opening then cast(u32)0x250c else cast(u32)0x251c, Role.NODE)
            CanvasSet(canvas, right, top, ifx opening then cast(u32)0x2510 else cast(u32)0x2524, Role.NODE)
            PutText(canvas, left + 2, top, *event.text); line := top + 1
            while line < top + 3 {
                CanvasSet(canvas, left, line, cast(u32)0x2502, Role.NODE); CanvasSet(canvas, right, line, cast(u32)0x2502, Role.NODE); line += 1
            }
        } else if event.kind == .CLOSE {
            depth -= 1; left := depth * 2; right := width - 1 - left; x := left
            while x <= right { CanvasSet(canvas, x, top, cast(u32)0x2500, Role.NODE); x += 1 }
            CanvasSet(canvas, left, top, cast(u32)0x2514, Role.NODE); CanvasSet(canvas, right, top, cast(u32)0x2518, Role.NODE)
            line := top + 1
            while line < top + 3 {
                CanvasSet(canvas, left, line, cast(u32)#char " ", Role.NODE); CanvasSet(canvas, right, line, cast(u32)#char " ", Role.NODE); line += 1
            }
        }
        index += 1
    }
    y := 0
    while y < height {
        x := width - 1
        while x >= 0 {
            if canvas.points[y * width + x] != cast(u32)#char " " {
                if x >= max_width { return .TOO_WIDE }
                break
            }
            x -= 1
        }
        y += 1
    }
    return .NONE
}
