#scope_module
// Family-aware statement scanning, ported from the original bounded grammar.

Statements :: (source: string, output: *Vec(Statement), count: *s32) -> Error {
    count.* = 0
    cursor: s64 = 0
    class_body := false
    header: string = ""
    while cursor <= source.count {
        end := IndexByteFrom(source, cursor, cast(u8)10)
        if end < 0 { end = cast(s64)source.count }
        line := Trim(source[cursor:end])
        cursor = end + 1
        if StartsWith(line, "%%{") { return .UNSUPPORTED }
        if StartsWith(line, "%%") { continue }
        if HasEntity(line) { return .UNSUPPORTED }
        rest := line
        while rest.count > 0 {
            if header == "classDiagram" &&
               (class_body || (StartsWith(rest, "class ") && HasOpenBraceBeforeSemicolon(rest))) {
                class_body = rest != "}"
                VecPush(<<output, Range(source, rest))
                count.* += 1
                break
            }
            colon_text := header == "classDiagram" || header == "stateDiagram" || header == "stateDiagram-v2"
            flowchart := SplitWhitespaceFirst(header) == "flowchart" || SplitWhitespaceFirst(header) == "graph"
            close: s64 = -1
            close_byte: u8 = 0
            quoted := false
            literal := header == "sequenceDiagram"
            index: s64 = 0
            statement_end := cast(s64)-1
            while index < rest.count {
                byte := rest[index]
                if byte == cast(u8)#char "\"" && !literal { quoted = !quoted }
                else if byte == cast(u8)#char ":" && colon_text && !quoted { literal = true }
                else if byte == cast(u8)#char ";" && !quoted && close < 0 { statement_end = index; break }
                else if flowchart && !quoted {
                    if close >= 0 && byte == close_byte { close = -1 }
                    else if close < 0 && byte == cast(u8)#char "[" { close = cast(s64)byte; close_byte = cast(u8)#char "]" }
                    else if close < 0 && byte == cast(u8)#char "{" { close = cast(s64)byte; close_byte = cast(u8)#char "}" }
                    else if close < 0 && byte == cast(u8)#char "|" { close = cast(s64)byte; close_byte = byte }
                }
                index += 1
            }
            statement := rest
            remaining: string = ""
            if statement_end >= 0 {
                statement = rest[0:statement_end]
                remaining = rest[statement_end + 1:rest.count]
            }
            statement = Trim(statement)
            if statement.count > 0 {
                if count.* == 0 { header = statement }
                VecPush(<<output, Range(source, statement))
                count.* += 1
            }
            rest = Trim(remaining)
        }
        if cursor >= source.count { break }
    }
    return .NONE
}

Range :: (source: string, value: string) -> Statement {
    result: Statement
    result.text = value
    return result
}

IndexByteFrom :: (value: string, start: s64, wanted: u8) -> s64 {
    index := start
    while index < value.count {
        if value[index] == wanted { return index }
        index += 1
    }
    return -1
}

HasEntity :: (line: string) -> bool {
    index: s64 = 0
    while index < line.count {
        byte := line[index]
        if byte == cast(u8)#char "#" || byte == cast(u8)#char "&" {
            end := index + 1
            while end < line.count && IsIdentifierByte(line[end]) { end += 1 }
            if end > index + 1 && end < line.count && line[end] == cast(u8)#char ";" { return true }
        }
        index += 1
    }
    return false
}

HasOpenBraceBeforeSemicolon :: (value: string) -> bool {
    declaration_end := IndexByte(value, cast(u8)#char "{")
    if declaration_end < 0 { return false }
    return IndexByte(value[0:declaration_end], cast(u8)#char ";") < 0
}
