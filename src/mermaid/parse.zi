#scope_module
// Strict flowchart parsing with node groups expanded into bounded edges.


Cursor :: struct {
    value: string
    rest: string
    at: s32
}

Indices :: struct {
    values: [MAX_EDGES]s32
    count: s32
    rest: string
}

ParseFlowchart :: (header: string, source: string, statements: []Statement, count: s32, graph: *Graph) -> Error {
    tokens := SplitWhitespaceFirst(header)
    remainder := header
    direction := Direction.DOWN
    if (tokens == "flowchart") || (tokens == "graph") {
        if remainder.count > tokens.count {
            next := Trim(remainder[tokens.count:remainder.count])
            if IndexByte(next, cast(u8)#char " ") >= 0 { return .UNSUPPORTED }
            parsed := ParseDirection(next)
            if !ValidDirection(next, parsed) { return .UNSUPPORTED }
            direction = parsed
        }
    } else { return .UNSUPPORTED }
    graph.direction = direction
    statement_at: s32 = 0
    while statement_at < count {
        statement := statements[statement_at].text
        statement_at += 1
        rest := statement
        from := ParseNodes(rest, graph); rest = from.rest
            if from.count < 0 { return ErrorFromInt(from.count) }
        while TrimStart(rest).count > 0 {
            rest = TrimStart(rest)
            label: Label
            source_tip := cast(u32)0x2500
            target_tip := cast(u32)0x25c4
            dashed := false
            if StartsWith(rest, "<-.->") {
                rest = rest[5:rest.count]; source_tip = 0x25c4; target_tip = 0x25c4; dashed = true
            } else if StartsWith(rest, "<-->") {
                rest = rest[4:rest.count]; source_tip = 0x25c4; target_tip = 0x25c4
            } else if StartsWith(rest, "-.->") {
                rest = rest[4:rest.count]; target_tip = 0x25c4; dashed = true
            } else if StartsWith(rest, "-.-") {
                rest = rest[3:rest.count]; target_tip = source_tip; dashed = true
            } else if StartsWith(rest, "-->") {
                rest = rest[3:rest.count]
            } else if StartsWith(rest, "---") {
                rest = rest[3:rest.count]; target_tip = source_tip
            } else {
                stem: string = "--"
                if StartsWith(rest, "--") { rest = rest[2:rest.count]; dashed = false }
                else if StartsWith(rest, "-.") { rest = rest[2:rest.count]; stem = ".-"; dashed = true }
                else { return .UNSUPPORTED }
                closing := IndexSubsequence(rest, stem)
                if closing < 0 { return .UNSUPPORTED }
                text := rest[0:closing]
                if text.count == 0 || text[0] > cast(u8)#char " " || text[text.count - 1] > cast(u8)#char " " { return .UNSUPPORTED }
                rest = rest[closing + 2:rest.count]
                if !StartsWith(rest, ">") { return .UNSUPPORTED }
                rest = rest[1:rest.count]
                converted := FlowchartLabel(Trim(text))
                if converted.at < 0 { return .UNSUPPORTED }
                if !LabelSet(*label, converted.value) { return .LIMIT }
                status := CheckLabelLabel(*label)
                if status != .NONE { return status }
            }
            if target_tip == source_tip && (StartsWith(rest, "o") || StartsWith(rest, "x")) { return .UNSUPPORTED }
            rest = TrimStart(rest)
            if StartsWith(rest, "|") {
                parsed := DelimitedLabel(rest[1:rest.count], "|")
                if parsed.at < 0 { return ErrorFromInt(parsed.at) }
                converted := FlowchartLabel(parsed.value)
                if converted.at < 0 || !LabelSet(*label, converted.value) { return .UNSUPPORTED }
                status := CheckLabelLabel(*label)
                if status != .NONE { return status }
                rest = parsed.rest
            }
            to := ParseNodes(rest, graph); rest = to.rest
            if to.count < 0 { return ErrorFromInt(to.count) }
            if cast(s64)from.count * cast(s64)to.count > MAX_EDGES - graph.edge_count { return .LIMIT }
            for left: 0..from.count - 1 {
                for right: 0..to.count - 1 {
                    edge := *graph.edges[graph.edge_count]
                    edge.from = from.values[left]; edge.to = to.values[right]
                    LabelSetLabel(*edge.label, *label)
                    edge.source_tip = source_tip; edge.target_tip = target_tip; edge.dashed = dashed
                    graph.edge_count += 1
                }
            }
            from = to
        }
    }
    if graph.node_count == 0 { return .UNSUPPORTED }
    return .NONE
}

ParseDirection :: (value: string) -> Direction {
    if value == "TD" || value == "TB" { return .DOWN }
    if value == "BT" { return .UP }
    if value == "LR" { return .RIGHT }
    if value == "RL" { return .LEFT }
    return .DOWN
}

ValidDirection :: (value: string, parsed: Direction) -> bool {
    if parsed == .DOWN { return value == "TD" || value == "TB" }
    if parsed == .UP { return value == "BT" }
    if parsed == .RIGHT { return value == "LR" }
    if parsed == .LEFT { return value == "RL" }
    return false
}

ParseNodes :: (source: string, graph: *Graph) -> Indices {
    result: Indices
    first := ParseNode(source, graph)
    result.rest = first.rest
    if first.at < 0 { result.count = first.at; return result }
    result.values[0] = first.at; result.count = 1
    while true {
        rest := TrimStart(result.rest)
        if !StartsWith(rest, "&") { break }
        if result.count == MAX_EDGES { result.count = ErrorInt(.LIMIT); break }
        next := ParseNode(rest[1:rest.count], graph)
        result.rest = next.rest
        if next.at < 0 { result.count = next.at; break }
        result.values[result.count] = next.at; result.count += 1
    }
    return result
}

ParseNode :: (source: string, graph: *Graph) -> Cursor {
    rest := source
    id := ParseIdentifier(rest); rest = id.rest

    if id.at < 0 { return .{at = id.at , rest = rest}}
    reserved := id.value == "end" || id.value == "subgraph" ||
                id.value == "direction" || id.value == "style" ||
                id.value == "class" || id.value == "classDef" ||
                id.value == "linkStyle" || id.value == "click"
    if reserved { return .{at = ErrorInt(.UNSUPPORTED) , rest = rest}}
    if StartsWith(rest, "[(") || StartsWith(rest, "[[") || StartsWith(rest, "[/") ||
       StartsWith(rest, "[\\") || StartsWith(rest, "{{") { return .{at = ErrorInt(.UNSUPPORTED) , rest = rest}}
    open: string = ""; close: string = ""; shape := Shape.RECTANGLE
    declaration := false
    if StartsWith(rest, "[") { open = "["; close = "]"; declaration = true }
    else if StartsWith(rest, "{") { open = "{"; close = "}"; shape = .DECISION; declaration = true }
    else if StartsWith(rest, "([") { open = "(["; close = "])"; shape = .STADIUM; declaration = true }
    index := GraphNode(graph, id.value)
    if index < 0 { return .{at = index , rest = rest}}
    if declaration {
        node := *graph.nodes[index]
        parsed := DelimitedLabel(rest[open.count:rest.count], close)
        if parsed.at < 0 { return .{at = parsed.at , rest = rest}}
        transformed := FlowchartLabel(parsed.value)
        if transformed.at < 0 { return .{at = transformed.at , rest = rest}}
        previous: Label
        LabelSetLabel(*previous, *node.label)
        if !LabelSet(*node.label, transformed.value) { return .{at = ErrorInt(.UNSUPPORTED) , rest = rest}}
        ReplaceBr(*node.label)
        node_label := LabelView(node.label.bytes[:], node.label.overflow[:], node.label.length)
        if Trim(node_label).count == 0 { return .{at = ErrorInt(.UNSUPPORTED) , rest = rest}}
        status := CheckLabelLines(*node.label)
        if status != .NONE { return .{at = ErrorInt(status) , rest = rest}}
            rest = parsed.rest
        if node.declared && (!LabelEqual(*previous, *node.label) || node.shape != shape) {
            return .{at = ErrorInt(.UNSUPPORTED), rest = rest}
        }
        node.shape = shape; node.declared = true
    }
    return .{at = index, rest = rest}
}

FlowchartLabel :: (raw: string) -> Cursor {
    result: Cursor
    result.at = ErrorInt(.UNSUPPORTED)
    value := raw
    if StartsWith(value, "\"`") { return result }
    if StartsWith(value, "\"") {
        if !EndsWith(value, "\"") || value.count < 2 { return result }
        value = value[1:value.count - 1]
    } else if ContainsByte(value, cast(u8)#char "[") || ContainsByte(value, cast(u8)#char "]") ||
              ContainsByte(value, cast(u8)#char "{") || ContainsByte(value, cast(u8)#char "}") ||
              ContainsByte(value, cast(u8)#char "|") { return result }
    if ContainsByte(value, cast(u8)#char "\"") { return result }
    result.value = value; result.at = 0
    return result
}

DelimitedLabel :: (text: string, close: string) -> Cursor {
    result: Cursor
    result.at = ErrorInt(.UNSUPPORTED)
    if StartsWith(text, "\"") {
        closing := IndexByte(text[1:text.count], cast(u8)#char "\"")
        if closing < 0 { return result }
        after := closing + 2
        if after > text.count || !StartsWith(text[after:text.count], close) { return result }
        result.value = text[0:after]; result.rest = text[after + close.count:text.count]; result.at = 0
        return result
    }
    closing := IndexSubsequence(text, close)
    if closing < 0 { return result }
    result.value = text[0:closing]; result.rest = text[closing + close.count:text.count]; result.at = 0
    return result
}

ParseIdentifier :: (source: string) -> Cursor {
    result: Cursor
    result.at = ErrorInt(.UNSUPPORTED)
    text := TrimStart(source)
    length: s64 = 0
    while length < text.count && IsIdentifierByte(text[length]) { length += 1 }
    if length == 0 || !(text[0] >= cast(u8)#char "a" && text[0] <= cast(u8)#char "z") &&
       !(text[0] >= cast(u8)#char "A" && text[0] <= cast(u8)#char "Z") || length > MAX_LABEL { return result }
    result.value = text[0:length]; result.rest = text[length:text.count]; result.at = 0
    return result
}

CheckLabel :: (label: string) -> Error {
    if MarkupLabel(label) || Trim(label).count == 0 { return .UNSUPPORTED }
    at: s32 = 0
    total: s32 = 0
    ligature_risk := false
    while at < cast(s32)label.count {
        byte := label[at]
        if byte < 128 {
            if byte < 32 || byte == 127 { return .UNSUPPORTED }
            total += 1; at += 1; continue
        }
        decoded := Utf8.Decode(label, at)
        point := decoded.value
        width := PointWidth(point)
        if IsControl(point) || width <= 0 || point == 0x250c || point == 0x2510 || point == 0x2514 || point == 0x2518 || point == 0x251c || point == 0x2524 || point == 0x256a || point == 0x25c4 { return .UNSUPPORTED }
        if point >= 0x600 { ligature_risk = true }
        total += width
        at = decoded.after
    }
    if ligature_risk && HasWidthLigature(label) { return .UNSUPPORTED }
    if total > MAX_LABEL { return .LIMIT }
    return .NONE
}

CheckLabelLabel :: (label: *Label) -> Error {
    return CheckLabel(LabelView(label.bytes[:], label.overflow[:], label.length))
}

CheckLabelLines :: (label: *Label) -> Error {
    start: s32 = 0
    at: s32 = 0
    while at <= label.length {
        if at == label.length || LabelByte(label, at) == cast(u8)#char "\n" {
            if at > start {
                status := CheckLabel(LabelView(label.bytes[:], label.overflow[:], label.length)[start:at])
                if status != .NONE { return status }
            }
            start = at + 1
        }
        at += 1
    }
    return .NONE
}

MarkupLabel :: (label: string) -> bool {
    index: s64 = 0
    while index < label.count {
        if label[index] == cast(u8)#char "<" && index + 1 < label.count {
            next := label[index + 1]
            alpha := (next >= cast(u8)#char "a" && next <= cast(u8)#char "z") || (next >= cast(u8)#char "A" && next <= cast(u8)#char "Z")
            if alpha || next == cast(u8)#char "/" || next == cast(u8)#char "!" || next == cast(u8)#char "?" {
                return true
            }
        }
        index += 1
    }
    return false
}

// Normalize in place: each break token shrinks, so unread bytes remain intact.
ReplaceBr :: (label: *Label) {
    at: s32 = 0; written: s32 = 0
    old := label.length
    while at < old {
        count: s32 = 0
        if StartsAt(label, at, "<br/>", 5) { count = 5 }
        else if StartsAt(label, at, "<br />", 6) { count = 6 }
        else if StartsAt(label, at, "<br>", 4) { count = 4 }
        if count > 0 { LabelPut(label, written, cast(u8)#char "\n"); at += count }
        else { LabelPut(label, written, LabelByte(label, at)); at += 1 }
        written += 1
    }
    if old > LABEL_BYTES && written <= LABEL_BYTES {
        index: s32 = 0
        while index < written { label.bytes[index] = label.overflow[index]; index += 1 }
    }
    label.length = written
}

StartsAt :: (label: *Label, at: s32, text: string, length: s32) -> bool {
    if at + length > label.length { return false }
    index: s32 = 0
    while index < length {
        if LabelByte(label, at + index) != text[index] { return false }
        index += 1
    }
    return true
}

GraphNode :: (graph: *Graph, id: string) -> s32 {
    index: s32 = 0
    while index < graph.node_count {
        if LabelEqualText(*graph.nodes[index].id, id) { return index }
        index += 1
    }
    if graph.node_count == MAX_NODES { return ErrorInt(.LIMIT) }
    node := *graph.nodes[graph.node_count]
    if !LabelSet(*node.id, id) || !LabelSet(*node.label, id) { return ErrorInt(.UNSUPPORTED) }
    node.shape = .RECTANGLE; node.declared = false; node.member_count = 0
    graph.node_count += 1
    return graph.node_count - 1
}

ErrorInt :: (status: Error) -> s32 {
    return -cast(s32)status
}

ErrorFromInt :: (code: s32) -> Error {
    if code == -2 { return .LIMIT }
    if code == -3 { return .TOO_WIDE }
    return .UNSUPPORTED
}

IndexSubsequence :: (value: string, wanted: string) -> s64 {
    if wanted.count > value.count { return -1 }
    index: s64 = 0
    while index + wanted.count <= value.count {
        if value[index:index + wanted.count] == wanted { return index }
        index += 1
    }
    return -1
}
